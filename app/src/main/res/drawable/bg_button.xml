<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#336E89AD">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#172237" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="#34463B" />
                    <stroke android:width="1dp" android:color="@color/primary" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface_raised" />
                    <stroke android:width="1dp" android:color="@color/outline" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
